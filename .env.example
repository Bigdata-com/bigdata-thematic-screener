# Copy to `.env` and fill in values. Never commit `.env`.
# See README for Bigdata.com and OpenAI setup.

# Required unless DEMO_MODE=true
BIGDATA_API_KEY=<your-bigdata-api-key>
OPENAI_API_KEY=<your-openai-api-key>

# Optional: ETF exposure lookups (Financial Modeling Prep). Leave empty to disable.
FMP_API_KEY=

# Optional: if set, API + UI require the same value as query param ?token=...
# ACCESS_TOKEN=

# Optional overrides (defaults are usually fine)
# DB_STRING=sqlite:///thematic_screener.db
# HOST=0.0.0.0
# PORT=8000
